# Vorlage: Diese Datei nach ".env" kopieren und eigene Werte eintragen.
# Die .env selbst darf niemals committet werden.

# Verbindung zur PostgreSQL-Datenbank
DATABASE_URL="postgresql://BENUTZER:PASSWORT@localhost:5432/DATENBANK"

# Optional: leere Hilfsdatenbank für "prisma migrate dev"
SHADOW_DATABASE_URL="postgresql://BENUTZER:PASSWORT@localhost:5432/DATENBANK_SHADOW"

# Geheimer Schlüssel zum Signieren der Session-Cookies.
# Erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="DEIN_ZUFAELLIGER_SCHLUESSEL"
